{
  "data_root": "/data/ReaSeg/data",
  "datasets": [
    "Skin",
    "BraTS",
    "Poly",
    "Breast",
    "Kidney",
    "Liver",
    "Lung",
    "Pancreas",
    "Prostate",
    "Thyroid"
  ],
  "train_split": "train",
  "val_split": "val",
  "medsam_checkpoint": "/data/ReaSeg/pretrained/medsam_vit_b.pth",
  "model_type": "vit_b",
  "text_encoder": "/data/ReaSeg/pretrained/bert-base-uncased",
  "text_max_length": 64,
  "local_files_only": true,
  "cross_attn_layers": [
    2,
    5,
    6,
    11
  ],
  "cross_attn_heads": 12,
  "vision_dim": 768,
  "image_size": 1024,
  "prompt_p_context": 0.8,
  "train_box_mode": "mixed",
  "bbox_shift": 20,
  "enlarge_ratio": 1.5,
  "lambda_patch": 0.0,
  "no_patch_head": true,
  "epochs": 50,
  "batch_size": 2,
  "val_batch_size": 2,
  "profile_compute": true,
  "num_workers": 4,
  "lr_connector": 0.0001,
  "lr_gca": 0.0001,
  "lr_mask_decoder": 5e-05,
  "lr_patch_head": 0.0001,
  "weight_decay": 0.01,
  "grad_clip": 1.0,
  "amp": "bf16",
  "seed": 2026,
  "save_every": 10,
  "val_every": 1,
  "gpu_ids": "0,1,2,3,4,5",
  "num_gpus": 6,
  "dist_backend": "nccl",
  "ddp_find_unused_parameters": false,
  "smoke_batches": 0
}
