{
  "data_root": "/data/ReaSeg/data",
  "datasets": [
    "Skin",
    "BraTS",
    "Poly",
    "Breast",
    "Kidney",
    "Liver",
    "Lung",
    "Pancreas",
    "Prostate",
    "Thyroid"
  ],
  "train_split": "train",
  "val_split": "val",
  "image_size": 1024,
  "bbox_shift": 20,
  "enlarge_ratio": 1.5,
  "train_box_mode": "mixed",
  "eval_box_mode": "tight",
  "vision_type": "TC_MVE",
  "medsam_checkpoint": "/data/ReaSeg/pretrained/medsam_vit_b.pth",
  "model_type": "vit_b",
  "steer_text_encoder": "/data/ReaSeg/pretrained/bert-base-uncased",
  "steer_cross_attn_layers": [
    2,
    5,
    6,
    11
  ],
  "steer_text_max_length": 64,
  "vision_dim": 768,
  "llm_name_or_path": "/data/ReaSeg/pretrained/Qwen3.5-2B-SEG",
  "llm_torch_dtype": "bf16",
  "trust_remote_code": false,
  "local_files_only": true,
  "max_length": 1024,
  "seg_token": "[SEG]",
  "use_lora": true,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "lora_target_modules": "q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj",
  "visual_grid": 16,
  "stage": "unified",
  "lambda_lm": 1.0,
  "lambda_mask": 1.0,
  "seg_loss_weight": 1.0,
  "train_lm_embeddings": true,
  "train_lm_head": true,
  "lr_lm_embedding": 1e-05,
  "lr_lm_head": 1e-05,
  "allow_non_permanent_seg_token": false,
  "epochs": 30,
  "batch_size": 2,
  "num_workers": 4,
  "lr_projector": 0.0001,
  "lr_mask_decoder": 5e-05,
  "lr_lora": 0.0001,
  "weight_decay": 0.01,
  "grad_clip": 1.0,
  "precision": "bf16",
  "seed": 2026,
  "save_every": 10,
  "val_every": 1,
  "print_trainable_names": false,
  "gpu_ids": "0,1,2,3,4,5",
  "num_gpus": 6,
  "dist_backend": "nccl",
  "ddp_find_unused_parameters": true,
  "lambda_attn": 1.0,
  "lambda_box": 0.5,
  "lambda_prompt": 0.5,
  "num_reasoning_queries": 4,
  "num_pos_points": 4,
  "num_neg_points": 4,
  "grounder_layers": 2,
  "grounder_dim": 256,
  "unfreeze_steer_modules": false,
  "unfreeze_last_vit_blocks": 0,
  "lr_grounding": 0.0001,
  "lr_steer": 1e-06,
  "lr_vision": 1e-06,
  "system_prompt": "You are a helpful medical image segmentation assistant.",
  "gradient_checkpointing": true,
  "max_new_tokens": 512,
  "smoke_batches": 0,
  "val_batch_size": 2,
  "profile_compute": true
}
